<?xml version="1.0" encoding="utf-8"?>
<!--
  This fork has no update feed. Sparkle's Check for Updates was removed because the upstream feed is signed with
  the original author's key: applying one of its updates would replace this Chinese edition with the English
  original, and Sparkle won't install over an ad-hoc signed build either. New versions come from
  https://github.com/kkwking123/Compositor-CN/releases.

  Config/Info.plist notes what turning the updater back on takes. If it comes back, this file becomes the feed:
  an <item> per version, each with sparkle:version, sparkle:shortVersionString and an <enclosure> signed with
  Sparkle's sign_update.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>Compositor 简体中文版</title>
    <link>https://github.com/kkwking123/Compositor-CN/releases</link>
    <description>本分支不提供自动更新，新版本从 Releases 页面下载。</description>
  </channel>
</rss>
